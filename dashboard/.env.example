# Cadena del TRANSACTION pooler de Supabase (puerto 6543). Es el adecuado para
# funciones serverless: el Session pooler (5432) sirve, pero abre una conexion
# por instancia y el plan free tiene pocas.
#
# El usuario va como '<rol>.<project-ref>'.
DATABASE_URL=postgresql://dashboard_ro.PROJECT_REF:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Cadena del rol de ESCRITURA (app_rw), que usan solo las pantallas de
# recepcion. El panel sigue leyendo con la de arriba, que no puede escribir.
# Crear el rol con dashboard/sql/app_rw.sql.
#
# Si se omite, se usa DATABASE_URL: comodo en desarrollo contra el Postgres
# local, donde el usuario ya es el dueno. En produccion hay que definirla.
DATABASE_URL_RW=postgresql://app_rw.PROJECT_REF:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Firma la cookie de sesion. 32 bytes al azar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Clave de EMERGENCIA, en scrypt. Solo sirve para entrar como administrador
# cuando core.usuario todavia esta vacia y hay que crear el primer usuario: no
# identifica a nadie, y con ella no se puede registrar un ingreso ni una salida.
# El acceso normal es con usuario y clave de core.usuario.
#   node scripts/hash.mjs "la clave que quieras"
DASHBOARD_PASSWORD_HASH=
