# Copiar a .env y ajustar. .env esta en .gitignore.
POSTGRES_DB=hostal_isan
POSTGRES_USER=hostal
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

PGADMIN_EMAIL=admin@hostalisan.cl
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Alternativa a las variables de arriba: si DATABASE_URL esta definida, el ETL
# la usa y descarta el resto. Es la forma de apuntar a un Postgres en la nube.
# DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require
